<?xml version="1.0" encoding="UTF-8"?>
<FLOW VERSION="3.0" CLEANUP="true">
  <COMMENT>Convert Dollar Amount String to Fixed Width Cents</COMMENT>
  <SEQUENCE TIMEOUT="" EXIT-ON="SUCCESS">
    <COMMENT>=== Outer Try/Catch Wrapper ===</COMMENT>

    <SEQUENCE TIMEOUT="" EXIT-ON="FAILURE">
      <COMMENT>=== Try Block ===</COMMENT>

      <!-- Step 1: Default if missing -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPSET NAME="Setter" OVERWRITE="false" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/dollarAmount;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">0.00</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
      </MAP>

      <!-- Step 2: Multiply by 100 with 0 precision -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/dollarAmount;1;0" TO="/num1;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/num2;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">100</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/precision;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">0</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="pub.math:multiplyFloats" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Multiply by 100</COMMENT>
      </INVOKE>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/value;1;0" TO="/rawCents;1;0"></MAPCOPY>
        <MAPDELETE NAME="Dropper" FIELD="/num1;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/num2;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/precision;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/value;1;0"></MAPDELETE>
      </MAP>

      <!-- Step 3: Pad Left to 10 digits zero-padded -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/rawCents;1;0" TO="/inString;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/padString;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">0</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/length;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">10</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="pub.string:padLeft" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Pad to 10 digits</COMMENT>
      </INVOKE>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/value;1;0" TO="/cents10;1;0"></MAPCOPY>
        <MAPDELETE NAME="Dropper" FIELD="/inString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/padString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/length;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/value;1;0"></MAPDELETE>
      </MAP>

      <!-- Step 4: Pad Left to 12 digits zero-padded -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/rawCents;1;0" TO="/inString;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/padString;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">0</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/length;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">12</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="pub.string:padLeft" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Pad to 12 digits</COMMENT>
      </INVOKE>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/value;1;0" TO="/cents12;1;0"></MAPCOPY>
        <MAPDELETE NAME="Dropper" FIELD="/inString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/padString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/length;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/value;1;0"></MAPDELETE>
      </MAP>

    </SEQUENCE>

    <SEQUENCE TIMEOUT="" EXIT-ON="DONE">
      <COMMENT>=== Catch Block ===</COMMENT>
      <INVOKE TIMEOUT="" SERVICE="pub.flow:getLastError" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Capture last error</COMMENT>
      </INVOKE>
      <INVOKE TIMEOUT="" SERVICE="pub.flow:throwExceptionForRetry" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Rethrow exception</COMMENT>
      </INVOKE>
    </SEQUENCE>

  </SEQUENCE>
</FLOW>
