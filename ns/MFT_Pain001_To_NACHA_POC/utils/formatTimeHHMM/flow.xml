<?xml version="1.0" encoding="UTF-8"?>
<FLOW VERSION="3.0" CLEANUP="true">
  <COMMENT>Format ISO Timestamp to HHMM</COMMENT>
  <SEQUENCE TIMEOUT="" EXIT-ON="SUCCESS">
    <COMMENT>=== Outer Try/Catch Wrapper ===</COMMENT>

    <SEQUENCE TIMEOUT="" EXIT-ON="FAILURE">
      <COMMENT>=== Try Block ===</COMMENT>

      <!-- Step 1: Substring chars 11 to 16 (HH:MM) -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/isoDate;1;0" TO="/inString;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/beginIndex;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">11</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/endIndex;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">16</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="pub.string:substring" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Extract HH:MM</COMMENT>
      </INVOKE>

      <!-- Step 3: Remove colon -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/value;1;0" TO="/inString;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/searchString;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">:</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/replaceString;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml"></value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="pub.string:replace" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Remove colon</COMMENT>
      </INVOKE>

      <!-- Step 4: Map to output hhmm and cleanup -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/value;1;0" TO="/hhmm;1;0"></MAPCOPY>
        <MAPDELETE NAME="Dropper" FIELD="/inString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/searchString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/replaceString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/beginIndex;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/endIndex;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/value;1;0"></MAPDELETE>
      </MAP>

    </SEQUENCE>

    <SEQUENCE TIMEOUT="" EXIT-ON="DONE">
      <COMMENT>=== Catch Block ===</COMMENT>
      <INVOKE TIMEOUT="" SERVICE="pub.flow:getLastError" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Capture last error</COMMENT>
      </INVOKE>
      <INVOKE TIMEOUT="" SERVICE="pub.flow:throwExceptionForRetry" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Rethrow exception</COMMENT>
      </INVOKE>
    </SEQUENCE>

  </SEQUENCE>
</FLOW>
