<?xml version="1.0" encoding="UTF-8"?>
<FLOW VERSION="3.0" CLEANUP="true">
  <COMMENT>Parse 94-Byte NACHA FlatFile to IS Document using pub.flatFile:convertToValues</COMMENT>
  <!-- Level 1: Outer Try/Catch Sequence Wrapper -->
  <SEQUENCE TIMEOUT="" EXIT-ON="SUCCESS">
    <COMMENT>=== Outer Try/Catch Wrapper ===</COMMENT>

    <!-- Level 2: Main Processing Sequence (Try Block) -->
    <SEQUENCE TIMEOUT="" EXIT-ON="FAILURE">
      <COMMENT>=== Try Block ===</COMMENT>

      <!-- Step 1: Handle Stream if ffData is null -->
      <BRANCH TIMEOUT="" SWITCH="/ffData">
        <SEQUENCE NAME="$null" TIMEOUT="" EXIT-ON="FAILURE">
          <BRANCH TIMEOUT="" SWITCH="/ffStream">
            <SEQUENCE NAME="$default" TIMEOUT="" EXIT-ON="FAILURE">
              <MAP TIMEOUT="" MODE="STANDALONE">
                <MAPCOPY NAME="Link" FROM="/ffStream;3;0" TO="/stream;3;0"></MAPCOPY>
              </MAP>
              <INVOKE TIMEOUT="" SERVICE="pub.io:streamToString" VALIDATE-IN="$none" VALIDATE-OUT="$none">
                <COMMENT>Convert Stream to String</COMMENT>
              </INVOKE>
              <MAP TIMEOUT="" MODE="STANDALONE">
                <MAPCOPY NAME="Link" FROM="/string;1;0" TO="/ffData;1;0"></MAPCOPY>
                <MAPDELETE NAME="Dropper" FIELD="/string;1;0"></MAPDELETE>
                <MAPDELETE NAME="Dropper" FIELD="/stream;3;0"></MAPDELETE>
              </MAP>
            </SEQUENCE>
          </BRANCH>
        </SEQUENCE>
      </BRANCH>

      <!-- Step 2: Set Flat File Schema and invoke pub.flatFile:convertToValues -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <COMMENT>Set Schema for convertToValues</COMMENT>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/ffSchema;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">MFT_Pain001_To_NACHA_POC.docs:ffs_NACHA_94Byte</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="pub.flatFile:convertToValues" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Standard Flat File Processing: convertToValues</COMMENT>
      </INVOKE>

      <!-- Step 3: Success Status and Cleanup -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/status;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">SUCCESS</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
        <MAPDELETE NAME="Dropper" FIELD="/ffSchema;1;0"></MAPDELETE>
      </MAP>

    </SEQUENCE>

    <!-- Level 2: Catch Sequence -->
    <SEQUENCE TIMEOUT="" EXIT-ON="DONE">
      <COMMENT>=== Catch Block ===</COMMENT>
      <INVOKE TIMEOUT="" SERVICE="pub.flow:getLastError" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Capture last error</COMMENT>
      </INVOKE>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/status;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">ERROR</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="pub.flow:throwExceptionForRetry" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Rethrow exception</COMMENT>
      </INVOKE>
    </SEQUENCE>

  </SEQUENCE>
</FLOW>
