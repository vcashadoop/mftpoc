<?xml version="1.0" encoding="UTF-8"?>
<FLOW VERSION="3.0" CLEANUP="true">
  <COMMENT>Format and Build NACHA Record 6 and Optional Record 7 for a Single Transaction</COMMENT>

  <!-- Level 1: Outer Try/Catch Sequence Wrapper -->
  <SEQUENCE TIMEOUT="" EXIT-ON="SUCCESS">
    <COMMENT>=== Outer Try/Catch Wrapper ===</COMMENT>

    <!-- Level 2: Try Block -->
    <SEQUENCE TIMEOUT="" EXIT-ON="FAILURE">
      <COMMENT>=== Try Block ===</COMMENT>

      <!-- Step 1: Routing Number & Check Digit Extraction -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <COMMENT>Extract 9-digit creditor routing</COMMENT>
        <MAPCOPY NAME="Link" FROM="/tx;2;0/CdtrAgt;2;0/FinInstnId;2;0/ClrSysMmbId;2;0/MmbId;1;0" TO="/routing9;1;0"></MAPCOPY>
      </MAP>
      <BRANCH TIMEOUT="" SWITCH="/routing9">
        <SEQUENCE NAME="$null" TIMEOUT="" EXIT-ON="FAILURE">
          <MAP TIMEOUT="" MODE="STANDALONE">
            <COMMENT>Fallback to Othr/Id if ClrSysMmbId not present</COMMENT>
            <MAPCOPY NAME="Link" FROM="/tx;2;0/CdtrAgt;2;0/FinInstnId;2;0/Othr;2;0/Id;1;0" TO="/routing9;1;0"></MAPCOPY>
          </MAP>
        </SEQUENCE>
      </BRANCH>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/routing9;1;0" TO="/inString;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/beginIndex;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">0</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/endIndex;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">8</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="pub.string:substring" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Extract first 8 digits -> recDfi</COMMENT>
      </INVOKE>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/value;1;0" TO="/recDfi;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/beginIndex;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">8</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/endIndex;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">9</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="pub.string:substring" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Extract 9th digit -> checkDigit</COMMENT>
      </INVOKE>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/value;1;0" TO="/checkDigit;1;0"></MAPCOPY>
        <MAPDELETE NAME="Dropper" FIELD="/routing9;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/inString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/beginIndex;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/endIndex;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/value;1;0"></MAPDELETE>
      </MAP>

      <!-- Step 2: DFI Account Number (17 chars right-padded) -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <COMMENT>Format creditor account number</COMMENT>
        <MAPCOPY NAME="Link" FROM="/tx;2;0/CdtrAcct;2;0/Id;2;0/Othr;2;0/Id;1;0" TO="/inString;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/targetLength;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">17</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/direction;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">RIGHT</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="MFT_Pain001_To_NACHA_POC.utils:formatFixedWidthField" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Pad account number</COMMENT>
      </INVOKE>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/outString;1;0" TO="/dfiAccount;1;0"></MAPCOPY>
        <MAPDELETE NAME="Dropper" FIELD="/inString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/targetLength;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/direction;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/outString;1;0"></MAPDELETE>
      </MAP>

      <!-- Step 3: Transaction Amount in Cents -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <COMMENT>Extract dollar amount</COMMENT>
        <MAPCOPY NAME="Link" FROM="/tx;2;0/Amt;2;0/InstdAmt;2;0/*body;1;0" TO="/dollarAmount;1;0"></MAPCOPY>
      </MAP>
      <BRANCH TIMEOUT="" SWITCH="/dollarAmount">
        <SEQUENCE NAME="$null" TIMEOUT="" EXIT-ON="FAILURE">
          <MAP TIMEOUT="" MODE="STANDALONE">
            <MAPCOPY NAME="Link" FROM="/tx;2;0/Amt;2;0/InstdAmt;1;0" TO="/dollarAmount;1;0"></MAPCOPY>
          </MAP>
        </SEQUENCE>
      </BRANCH>
      <INVOKE TIMEOUT="" SERVICE="MFT_Pain001_To_NACHA_POC.utils:convertAmountToCents" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Convert to cents</COMMENT>
      </INVOKE>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/cents10;1;0" TO="/amountCents;1;0"></MAPCOPY>
        <MAPCOPY NAME="Link" FROM="/rawCents;1;0" TO="/cents;1;0"></MAPCOPY>
        <MAPDELETE NAME="Dropper" FIELD="/dollarAmount;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/cents10;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/cents12;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/rawCents;1;0"></MAPDELETE>
      </MAP>

      <!-- Step 4: Creditor Name (22 chars) & EndToEndId (15 chars) -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <COMMENT>Format creditor name</COMMENT>
        <MAPCOPY NAME="Link" FROM="/tx;2;0/Cdtr;2;0/Nm;1;0" TO="/inString;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/targetLength;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">22</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/direction;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">RIGHT</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="MFT_Pain001_To_NACHA_POC.utils:formatFixedWidthField" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Format Creditor Name</COMMENT>
      </INVOKE>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/outString;1;0" TO="/cdtrName;1;0"></MAPCOPY>
        <MAPCOPY NAME="Link" FROM="/tx;2;0/PmtId;2;0/EndToEndId;1;0" TO="/inString;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/targetLength;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">15</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/direction;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">RIGHT</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="MFT_Pain001_To_NACHA_POC.utils:formatFixedWidthField" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Format EndToEndId</COMMENT>
      </INVOKE>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/outString;1;0" TO="/endToEndId;1;0"></MAPCOPY>
        <MAPDELETE NAME="Dropper" FIELD="/inString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/targetLength;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/direction;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/outString;1;0"></MAPDELETE>
      </MAP>

      <!-- Step 5: Detail Sequence & Trace Number -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <COMMENT>Format 7-digit detail sequence</COMMENT>
        <MAPCOPY NAME="Link" FROM="/seqNumber;1;0" TO="/inString;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/padString;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">0</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/length;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">7</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
      </MAP>
      <INVOKE TIMEOUT="" SERVICE="pub.string:padLeft" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Pad Detail Sequence</COMMENT>
      </INVOKE>
      <MAP TIMEOUT="" MODE="STANDALONE">
        <MAPCOPY NAME="Link" FROM="/value;1;0" TO="/detailSeq;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="true" GLOBALVARIABLES="false" FIELD="/traceNumber;1;0">
          <DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">%odfi%%detailSeq%</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA>
        </MAPSET>
        <MAPDELETE NAME="Dropper" FIELD="/inString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/padString;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/length;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/value;1;0"></MAPDELETE>
      </MAP>

      <!-- Step 6: Remittance / Addenda Record 7 -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <COMMENT>Check remittance info</COMMENT>
        <MAPCOPY NAME="Link" FROM="/tx;2;0/RmtInf;2;0/Ustrd;1;0" TO="/ustrdRaw;1;0"></MAPCOPY>
      </MAP>
      <BRANCH TIMEOUT="" SWITCH="/ustrdRaw">
        <!-- When Ustrd is present -->
        <SEQUENCE NAME="$default" TIMEOUT="" EXIT-ON="FAILURE">
          <MAP TIMEOUT="" MODE="STANDALONE">
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/hasAddenda;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">1</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/entryCount;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">2</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
            <MAPCOPY NAME="Link" FROM="/ustrdRaw;1;0" TO="/inString;1;0"></MAPCOPY>
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/targetLength;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">80</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/direction;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">RIGHT</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
          </MAP>
          <INVOKE TIMEOUT="" SERVICE="MFT_Pain001_To_NACHA_POC.utils:formatFixedWidthField" VALIDATE-IN="$none" VALIDATE-OUT="$none">
            <COMMENT>Format Remittance 80 chars</COMMENT>
          </INVOKE>
          <MAP TIMEOUT="" MODE="STANDALONE">
            <MAPCOPY NAME="Link" FROM="/outString;1;0" TO="/ustrd;1;0"></MAPCOPY>
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/addendaSeq;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">0001</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
            <MAPDELETE NAME="Dropper" FIELD="/inString;1;0"></MAPDELETE>
            <MAPDELETE NAME="Dropper" FIELD="/targetLength;1;0"></MAPDELETE>
            <MAPDELETE NAME="Dropper" FIELD="/direction;1;0"></MAPDELETE>
            <MAPDELETE NAME="Dropper" FIELD="/outString;1;0"></MAPDELETE>
          </MAP>
          <INVOKE TIMEOUT="" SERVICE="MFT_Pain001_To_NACHA_POC.services:buildRecord7" VALIDATE-IN="$none" VALIDATE-OUT="$none">
            <COMMENT>Build Record 7</COMMENT>
          </INVOKE>
        </SEQUENCE>
        <!-- When Ustrd is null -->
        <SEQUENCE NAME="$null" TIMEOUT="" EXIT-ON="FAILURE">
          <MAP TIMEOUT="" MODE="STANDALONE">
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/hasAddenda;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">0</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/entryCount;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">1</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/rec7;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml"></value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
          </MAP>
        </SEQUENCE>
      </BRANCH>

      <!-- Step 7: Build Record 6 -->
      <INVOKE TIMEOUT="" SERVICE="MFT_Pain001_To_NACHA_POC.services:buildRecord6" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Build Record 6</COMMENT>
      </INVOKE>

      <!-- Step 7b: Build Record 6 Document matching Flat File Schema with child Record 7 -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <COMMENT>Populate Record 6 Document</COMMENT>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/rec6Doc;2;0/recordTypeCode;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">6</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/rec6Doc;2;0/transactionCode;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">22</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
        <MAPCOPY NAME="Link" FROM="/recDfi;1;0" TO="/rec6Doc;2;0/receivingDFIIdentification;1;0"></MAPCOPY>
        <MAPCOPY NAME="Link" FROM="/checkDigit;1;0" TO="/rec6Doc;2;0/checkDigit;1;0"></MAPCOPY>
        <MAPCOPY NAME="Link" FROM="/dfiAccount;1;0" TO="/rec6Doc;2;0/dfiAccountNumber;1;0"></MAPCOPY>
        <MAPCOPY NAME="Link" FROM="/amountCents;1;0" TO="/rec6Doc;2;0/amount;1;0"></MAPCOPY>
        <MAPCOPY NAME="Link" FROM="/endToEndId;1;0" TO="/rec6Doc;2;0/individualCompanyIDNumber;1;0"></MAPCOPY>
        <MAPCOPY NAME="Link" FROM="/cdtrName;1;0" TO="/rec6Doc;2;0/individualCompanyName;1;0"></MAPCOPY>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/rec6Doc;2;0/discretionaryData;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">  </value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
        <MAPCOPY NAME="Link" FROM="/hasAddenda;1;0" TO="/rec6Doc;2;0/addendaRecordIndicator;1;0"></MAPCOPY>
        <MAPCOPY NAME="Link" FROM="/traceNumber;1;0" TO="/rec6Doc;2;0/traceNumber;1;0"></MAPCOPY>
      </MAP>
      <BRANCH TIMEOUT="" SWITCH="/hasAddenda">
        <SEQUENCE NAME="1" TIMEOUT="" EXIT-ON="FAILURE">
          <MAP TIMEOUT="" MODE="STANDALONE">
            <COMMENT>Attach child Record 7 to rec6Doc</COMMENT>
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/rec6Doc;2;0/7;2;0/recordTypeCode;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">7</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/rec6Doc;2;0/7;2;0/addendaTypeCode;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">05</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
            <MAPCOPY NAME="Link" FROM="/ustrd;1;0" TO="/rec6Doc;2;0/7;2;0/paymentRelatedInformation;1;0"></MAPCOPY>
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/rec6Doc;2;0/7;2;0/addendaSequenceNumber;1;0"><DATA ENCODING="XMLValues" I18N="true"><Values version="2.0"><value name="xml">0001</value><record name="type" javaclass="com.wm.util.Values"></record></Values></DATA></MAPSET>
            <MAPCOPY NAME="Link" FROM="/detailSeq;1;0" TO="/rec6Doc;2;0/7;2;0/entryDetailSequenceNumber;1;0"></MAPCOPY>
            <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="true" GLOBALVARIABLES="false" FIELD="/rec7;1;0">
              <DATA ENCODING="XMLValues" I18N="true">
                <Values version="2.0">
                  <value name="xml">705%ustrd;1;0%0001%detailSeq;1;0%</value>
                  <record name="type" javaclass="com.wm.util.Values"></record>
                </Values>
              </DATA>
            </MAPSET>
          </MAP>
        </SEQUENCE>
      </BRANCH>

      <!-- Assemble Record 6 string (94 bytes) -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <COMMENT>Assemble Record 6 string strictly 94 bytes</COMMENT>
        <MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="true" GLOBALVARIABLES="false" FIELD="/rec6;1;0">
          <DATA ENCODING="XMLValues" I18N="true">
            <Values version="2.0">
              <value name="xml">622%recDfi;1;0%%checkDigit;1;0%%dfiAccount;1;0%%amountCents;1;0%%endToEndId;1;0%%cdtrName;1;0%  %hasAddenda;1;0%%traceNumber;1;0%</value>
              <record name="type" javaclass="com.wm.util.Values"></record>
            </Values>
          </DATA>
        </MAPSET>
      </MAP>

      <!-- Step 8: Strict Pipeline Cleanup -->
      <MAP TIMEOUT="" MODE="STANDALONE">
        <COMMENT>Drop intermediate variables</COMMENT>
        <MAPDELETE NAME="Dropper" FIELD="/tx;2;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/odfi;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/seqNumber;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/checkDigit;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/dfiAccount;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/amountCents;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/cdtrName;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/endToEndId;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/detailSeq;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/ustrdRaw;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/ustrd;1;0"></MAPDELETE>
        <MAPDELETE NAME="Dropper" FIELD="/addendaSeq;1;0"></MAPDELETE>
      </MAP>

    </SEQUENCE>

    <!-- Level 2: Catch Block -->
    <SEQUENCE TIMEOUT="" EXIT-ON="DONE">
      <COMMENT>=== Catch Block ===</COMMENT>
      <INVOKE TIMEOUT="" SERVICE="pub.flow:getLastError" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Capture error</COMMENT>
      </INVOKE>
      <INVOKE TIMEOUT="" SERVICE="pub.flow:throwExceptionForRetry" VALIDATE-IN="$none" VALIDATE-OUT="$none">
        <COMMENT>Rethrow exception</COMMENT>
      </INVOKE>
    </SEQUENCE>

  </SEQUENCE>
</FLOW>
